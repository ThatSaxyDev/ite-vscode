{
  "name": "ite-the-agent",
  "displayName": "iTE, the agent",
  "description": "Run iTE in a dedicated VS Code terminal.",
  "version": "0.0.1",
  "publisher": "DedekeDavidIteoluwakiisi",
  "license": "MIT",
  "icon": "media/ite-large.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ite",
    "ai",
    "agent",
    "coding agent",
    "terminal",
    "cli",
    "developer tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ThatSaxyDev/ite-vscode"
  },
  "bugs": {
    "url": "https://github.com/ThatSaxyDev/ite-vscode/issues"
  },
  "homepage": "https://ite.kiishi.space",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "check": "node --check extension.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "ite.openTerminal",
        "title": "Open iTE",
        "category": "iTE"
      },
      {
        "command": "ite.openNewTerminal",
        "title": "Open iTE: New Terminal",
        "category": "iTE"
      },
      {
        "command": "ite.resumeLastSession",
        "title": "Open iTE: Last Session",
        "category": "iTE"
      }
    ],
    "configuration": {
      "title": "iTE",
      "properties": {
        "ite.executable": {
          "type": "string",
          "default": "ite",
          "description": "Path or command used to launch the iTE runtime."
        },
        "ite.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional command-line arguments passed to the iTE runtime."
        },
        "ite.resumeLastSession": {
          "type": "boolean",
          "default": true,
          "description": "Resume the most recent saved iTE session for the current workspace when opening the dedicated terminal."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "ite.openTerminal"
        },
        {
          "command": "ite.openNewTerminal"
        },
        {
          "command": "ite.resumeLastSession"
        }
      ],
      "terminal/title": [
        {
          "command": "ite.openTerminal",
          "group": "navigation"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "ite.terminalProfile",
          "title": "iTE",
          "icon": "terminal"
        }
      ]
    }
  }
}
