{
  "name": "ite-agent",
  "displayName": "iTE: the agent",
  "description": "Run iTE in a dedicated VS Code terminal.",
  "version": "0.0.1",
  "publisher": "IteoluwakiishiDedeke",
  "license": "MIT",
  "icon": "media/ite-large.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ite",
    "ai",
    "agent",
    "coding agent",
    "terminal",
    "cli",
    "developer tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kiishidavid/ite-vscode"
  },
  "bugs": {
    "url": "https://github.com/kiishidavid/ite-vscode/issues"
  },
  "homepage": "https://ite.kiishi.space",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "check": "node --check extension.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "ite.openTerminal",
        "title": "Open iTE",
        "category": "iTE"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ite.openTerminal"
        }
      ],
      "terminal/title": [
        {
          "command": "ite.openTerminal",
          "group": "navigation"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "ite.terminalProfile",
          "title": "iTE",
          "icon": "terminal"
        }
      ]
    }
  }
}
